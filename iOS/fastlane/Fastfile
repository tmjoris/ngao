default_platform(:ios)

platform :ios do
  desc "Generate the Xcode project and install pods"
  lane :prepare do
    sh("cd .. && xcodegen generate")
    cocoapods(podfile: "Podfile")
  end

  desc "Unit tests on the simulator"
  lane :test do
    prepare
    run_tests(
      workspace: "Ngao.xcworkspace",
      scheme: "Ngao",
      devices: ["iPhone 16"],
      only_testing: ["NgaoTests"],
      result_bundle: true,
      code_coverage: true
    )
  end

  desc "UI tests on the simulator"
  lane :ui_test do
    prepare
    run_tests(workspace: "Ngao.xcworkspace", scheme: "Ngao", devices: ["iPhone 16"], only_testing: ["NgaoUITests"])
  end

  desc "Build and upload to TestFlight (needs App Store Connect API key in env)"
  lane :beta do
    prepare
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
    increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"] || latest_testflight_build_number + 1)
    build_app(workspace: "Ngao.xcworkspace", scheme: "Ngao", export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
